{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindclade.dev/schemas/qualification-request-v1.schema.json",
  "title": "Mindclade production qualification request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "qualification_id",
    "change_reference",
    "qualification_level",
    "scope",
    "repositories",
    "checks",
    "module_references",
    "drill_evidence",
    "connected_boundary",
    "evidence_artifacts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "qualification_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{5,63}$"
    },
    "change_reference": {
      "type": "string",
      "pattern": "^(CHG|SEC|DR)-[A-Za-z0-9._-]+$"
    },
    "qualification_level": {"const": "production"},
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "repositories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        ".github",
        ".github-private",
        "bootstrap",
        "github-config",
        "infrastructure-live",
        "gitops",
        "mindclade-internal-monorepo"
      ],
      "properties": {
        ".github": {"$ref": "#/$defs/commit"},
        ".github-private": {"$ref": "#/$defs/commit"},
        "bootstrap": {"$ref": "#/$defs/commit"},
        "github-config": {"$ref": "#/$defs/commit"},
        "infrastructure-live": {"$ref": "#/$defs/commit"},
        "gitops": {"$ref": "#/$defs/commit"},
        "mindclade-internal-monorepo": {"$ref": "#/$defs/commit"}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "control_id", "status", "command", "detail", "evidence_key"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "control_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,127}$"},
          "status": {"const": "pass"},
          "command": {"type": "string", "minLength": 1},
          "detail": {"type": "string", "minLength": 1},
          "evidence_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"}
        }
      }
    },
    "module_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit", "source", "version", "qualified"],
        "properties": {
          "unit": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "version": {"type": "string", "pattern": "^v[0-9]+[.][0-9]+[.][0-9]+$"},
          "qualified": {"const": true}
        }
      }
    },
    "drill_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["drill_id", "report_uri", "sha256", "result"],
        "properties": {
          "drill_id": {"type": "string", "minLength": 1},
          "report_uri": {"type": "string", "pattern": "^(gs://|https://github[.]com/).+"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "result": {"const": "pass"}
        }
      }
    },
    "connected_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performed", "environments", "mutations", "detail"],
      "properties": {
        "performed": {"const": true},
        "environments": {
          "type": "array",
          "uniqueItems": true,
          "allOf": [
            {"contains": {"const": "staging"}},
            {"contains": {"const": "production"}}
          ],
          "items": {
            "enum": ["scratch", "development", "staging", "production"]
          }
        },
        "mutations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "evidence_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "repository",
          "run_id",
          "artifact_name",
          "sha256"
        ],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
          "repository": {
            "enum": [
              ".github",
              ".github-private",
              "bootstrap",
              "github-config",
              "infrastructure-live",
              "gitops",
              "mindclade-internal-monorepo"
            ]
          },
          "run_id": {"type": "integer", "minimum": 1},
          "artifact_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
