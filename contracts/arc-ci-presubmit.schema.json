{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mindclade/gitops/contracts/arc-ci-presubmit.schema.json",
  "title": "Mindclade ARC presubmit readiness contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "const": "ci.mindclade.dev/v1alpha1"
    },
    "kind": {
      "const": "ArcPresubmitReadiness"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "const": "mindclade-arc-presubmit-spot"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "selected",
        "routing",
        "capacity",
        "placement",
        "runnerImage",
        "security",
        "gates"
      ],
      "properties": {
        "phase": {
          "enum": ["blocked", "qualified", "canary", "activated"]
        },
        "selected": {
          "type": "boolean"
        },
        "routing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["githubConfigUrl", "runnerGroup", "scaleSetName", "namespace"],
          "properties": {
            "githubConfigUrl": {
              "const": "https://github.com/mindclade"
            },
            "runnerGroup": {
              "const": "mindclade-arc-ci"
            },
            "scaleSetName": {
              "const": "mindclade-arc-presubmit-spot"
            },
            "namespace": {
              "const": "arc-presubmit"
            }
          }
        },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["configured", "activatedTarget"],
          "properties": {
            "configured": {
              "$ref": "#/$defs/capacity"
            },
            "activatedTarget": {
              "$ref": "#/$defs/capacity"
            }
          }
        },
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "infrastructureUnit",
            "capacityType",
            "maxNodes",
            "runnersPerNode",
            "nodeSelector",
            "tolerations"
          ],
          "properties": {
            "infrastructureUnit": {
              "const": "5-workloads/ci/nodepools/runner-spot"
            },
            "capacityType": {
              "const": "SPOT"
            },
            "maxNodes": {
              "const": 8
            },
            "runnersPerNode": {
              "const": 3
            },
            "nodeSelector": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "iam.gke.io/gke-metadata-server-enabled",
                "mindclade.dev/workload-class"
              ],
              "properties": {
                "iam.gke.io/gke-metadata-server-enabled": {
                  "const": "true"
                },
                "mindclade.dev/workload-class": {
                  "const": "arc-presubmit-spot"
                }
              }
            },
            "tolerations": {
              "type": "array",
              "prefixItems": [
                {
                  "$ref": "#/$defs/spotToleration"
                },
                {
                  "$ref": "#/$defs/presubmitToleration"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "runnerImage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authorityRepository",
            "baseFlakePackage",
            "runnerFlakePackage",
            "repository",
            "digest",
            "sourceCommit",
            "releaseRecord",
            "validationFixture"
          ],
          "properties": {
            "authorityRepository": {
              "const": "mindclade/mindclade-internal-monorepo"
            },
            "baseFlakePackage": {
              "const": ".#remote-execution-base"
            },
            "runnerFlakePackage": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "repository": {
              "type": ["string", "null"],
              "pattern": "^[a-z0-9.-]+/[a-z0-9._/-]+$"
            },
            "digest": {
              "type": ["string", "null"],
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "sourceCommit": {
              "type": ["string", "null"],
              "pattern": "^[0-9a-f]{40}$"
            },
            "releaseRecord": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "validationFixture": {
              "type": "string",
              "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
            }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ephemeralRunners",
            "automountServiceAccountToken",
            "sharedWritableCacheVolume",
            "artifactSigningCredentials",
            "artifactPushCredentials",
            "remoteCacheWriteCredentials"
          ],
          "properties": {
            "ephemeralRunners": {
              "const": true
            },
            "automountServiceAccountToken": {
              "const": false
            },
            "sharedWritableCacheVolume": {
              "const": false
            },
            "artifactSigningCredentials": {
              "const": false
            },
            "artifactPushCredentials": {
              "const": false
            },
            "remoteCacheWriteCredentials": {
              "const": false
            }
          }
        },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nixBinaryCache",
            "runnerImage",
            "runnerGroup",
            "readOnlyCacheWif",
            "connectedCluster",
            "workflowRouting",
            "spotInterruption",
            "onDemandRollback"
          ],
          "properties": {
            "nixBinaryCache": {
              "$ref": "#/$defs/gate"
            },
            "runnerImage": {
              "$ref": "#/$defs/gate"
            },
            "runnerGroup": {
              "$ref": "#/$defs/gate"
            },
            "readOnlyCacheWif": {
              "$ref": "#/$defs/gate"
            },
            "connectedCluster": {
              "$ref": "#/$defs/gate"
            },
            "workflowRouting": {
              "$ref": "#/$defs/gate"
            },
            "spotInterruption": {
              "$ref": "#/$defs/gate"
            },
            "onDemandRollback": {
              "$ref": "#/$defs/gate"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "spotToleration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "operator", "value", "effect"],
      "properties": {
        "key": {"const": "scheduling.mindclade.dev/spot"},
        "operator": {"const": "Equal"},
        "value": {"const": "true"},
        "effect": {"const": "NoSchedule"}
      }
    },
    "presubmitToleration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "operator", "value", "effect"],
      "properties": {
        "key": {"const": "scheduling.mindclade.dev/arc-presubmit"},
        "operator": {"const": "Equal"},
        "value": {"const": "true"},
        "effect": {"const": "NoSchedule"}
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minRunners", "maxRunners"],
      "properties": {
        "minRunners": {
          "type": "integer",
          "minimum": 0
        },
        "maxRunners": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualified", "evidence"],
      "properties": {
        "qualified": {
          "type": "boolean"
        },
        "evidence": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["uri", "sha256", "reviewer", "reviewedAt"],
              "properties": {
                "uri": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "reviewer": {
                  "type": "string",
                  "pattern": "^@[A-Za-z0-9-]+$"
                },
                "reviewedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          ]
        }
      }
    }
  }
}
