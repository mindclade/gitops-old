{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindclade.dev/contracts/evidence/verification/v1",
  "title": "Independent evidence verification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verification_digest", "claim_digest", "policy_digest", "policy_epoch", "result", "reasons", "artifact", "verified_at", "valid_until"],
  "properties": {
    "schema_version": {"const": "mindclade.dev/evidence-verification/v1"},
    "verification_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "claim_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "policy_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "policy_epoch": {"type": "integer", "minimum": 1},
    "result": {"enum": ["pass", "fail"]},
    "reasons": {"type": "array", "maxItems": 128, "items": {"$ref": "common.schema.json#/$defs/canonicalName"}},
    "artifact": {"$ref": "common.schema.json#/$defs/artifact"},
    "verified_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "valid_until": {"$ref": "common.schema.json#/$defs/timestamp"}
  }
}
